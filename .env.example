# Static export under a GitHub Pages project path.
GITHUB_PAGES_BASE_PATH=/moliang
NEXT_PUBLIC_BASE_PATH=/moliang
# Public HTTPS URL only; never put credentials into NEXT_PUBLIC variables.
NEXT_PUBLIC_CODEX_USAGE_API_URL=
# Separate local aggregate usage service.
USAGE_API_HOST=127.0.0.1
USAGE_API_PORT=8787
CORS_ORIGIN=https://pueu.github.io
